import pygame as pg, math as m

pg.init(); w, h = 800, 600; screen = pg.display.set_mode((w, h))
clock = pg.time.Clock(); f_u = pg.font.SysFont('Arial', 20); f_d = pg.font.SysFont('Arial', 40)

def reset():
    global p_p, p_r, dy, hp, gm, menu, world
    p_p, p_r, dy, hp, gm, menu = [0.0, 2.0, -5.0], [0.0, 0.0], 0.0, 10.0, False, False
    pg.mouse.set_visible(False); pg.event.set_grab(True)
    world = [[x, 0, z, (34, 139, 34)] for x in range(-5, 5) for z in range(-5, 5)]
    for i in range(3): world.append([0, i+1, 0, (101, 67, 33)]) # Tree
reset()

def project(pos):
    x, y, z = pos[0]-p_p[0], pos[1]-p_p[1], pos[2]-p_p[2]
    nx = x*m.cos(p_r[1]) - z*m.sin(p_r[1])
    nz = x*m.sin(p_r[1]) + z*m.cos(p_r[1])
    ny = y*m.cos(p_r[0]) - nz*m.sin(p_r[0])
    nz = y*m.sin(p_r[0]) + nz*m.cos(p_r[0])
    if nz <= 0.1: return None
    return [int(w/2 + nx*(400/nz)), int(h/2 - ny*(400/nz))]

run = True
while run:
    screen.fill((135, 206, 235))
    for e in pg.event.get():
        if e.type == pg.QUIT: run = False
        if e.type == pg.KEYDOWN and e.key == pg.K_ESCAPE and not gm:
            menu = not menu
            pg.mouse.set_visible(menu); pg.event.set_grab(not menu)
        if (gm or menu) and e.type == pg.MOUSEBUTTONDOWN:
            mx, my = pg.mouse.get_pos()
            if 300 < mx < 500:
                if 220 < my < 270: (reset() if gm or menu else None); menu=False
                if 280 < my < 330: (reset() if menu else None); menu=False
                if 340 < my < 390: run = False
        if not gm and not menu and e.type == pg.MOUSEBUTTONDOWN:
            # Simple Raycast for Build/Destroy
            for b in sorted(world, key=lambda x: m.dist(x[:3], p_p)):
                if m.dist(b[:3], p_p) < 5:
                    if e.button == 1: world.remove(b); break
                    if e.button == 3: world.append([b[0], b[1]+1, b[2], (150, 150, 150)]); break

    if not gm and not menu:
        rel_x, rel_y = pg.mouse.get_rel()
        p_r[1] += rel_x * 0.003
        p_r[0] = max(-1.5, min(1.5, p_r[0] - rel_y * 0.003))
        keys = pg.key.get_pressed()
        sp, s, c_ = 0.1, m.sin(p_r[1]), m.cos(p_r[1])
        if keys[pg.K_w]: p_p[0]+=s*sp; p_p[2]+=c_*sp
        if keys[pg.K_s]: p_p[0]-=s*sp; p_p[2]-=c_*sp
        if keys[pg.K_a]: p_p[0]-=c_*sp; p_p[2]+=s*sp
        if keys[pg.K_d]: p_p[0]+=c_*sp; p_p[2]-=s*sp
        dy -= 0.01; p_p[1] += dy
        
        curr_g = -10.0
        for b in world:
            if b[0]-0.5 < p_p[0] < b[0]+1.5 and b[2]-0.5 < p_p[2] < b[2]+1.5:
                if b[1] < p_p[1] - 1.5: curr_g = max(curr_g, b[1]+1.8)
        if p_p[1] <= curr_g: p_p[1], dy = curr_g, 0
        if keys[pg.K_SPACE] and p_p[1] == curr_g: dy = 0.15
        if p_p[1] < -5: 
            hp -= 0.1
            if hp <= 0: gm = True; pg.mouse.set_visible(True); pg.event.set_grab(False)

    world.sort(key=lambda b: m.dist(b[:3], p_p), reverse=True)
    for b in world:
        v = [[b[0]+i, b[1]+j, b[2]+k] for i in (0,1) for j in (0,1) for k in (0,1)]
        for f in [(0,1,3,2), (5,4,6,7), (1,5,7,3), (4,0,2,6), (2,3,7,6), (4,5,1,0)]:
            pts = [project(v[i]) for i in f]
            if all(pts):
                pg.draw.polygon(screen, b[3], pts)
                pg.draw.polygon(screen, (0,0,0), pts, 1)

    for i in range(10): pg.draw.rect(screen, (255,0,0) if i < hp else (50,50,50), (20+i*25, 20, 20, 20))
    pg.draw.circle(screen, (255,255,255), (w//2, h//2), 3, 1)

    if gm or menu:
        ov = pg.Surface((w,h)); ov.set_alpha(180); ov.fill((200,0,0) if gm else (50,50,50))
        screen.blit(ov, (0,0))
        t_str = "YOU DIED" if gm else "PAUSED"
        txt = f_d.render(t_str, True, (255,255,255))
        screen.blit(txt, (w//2-txt.get_width()//2, 120))
        btns = ["RESPAWN", "QUIT"] if gm else ["RESUME", "RESET", "QUIT"]
        for i, b_t in enumerate(btns):
            pg.draw.rect(screen, (255,255,255), (300, 220+i*60, 200, 50), 2)
            screen.blit(f_u.render(b_t, True, (255,255,255)), (330, 230+i*60))

    pg.display.flip(); clock.tick(60)
pg.quit()
